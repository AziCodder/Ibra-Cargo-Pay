# Shell-скрипты и Dockerfile-ы всегда с LF, иначе сломаются в Linux-контейнерах.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
entrypoint.sh   text eol=lf
crontab         text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-специфика
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Бинарники
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
