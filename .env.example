# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=project_manager
DB_USER=postgres
DB_PASSWORD=replace-with-strong-password

# ─── Backend ──────────────────────────────────────────────────────────────────
# JWT signing secret (минимум 32 случайных символа). Сгенерировать:
#   openssl rand -hex 32
SECRET_KEY=replace-with-32-bytes-hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origin для CORS. На сервере замените на http(s)://<домен или IP>
FRONTEND_URL=http://localhost

# ─── S3-compatible storage (для файлов заявок/документов) ─────────────────────
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=project-manager
S3_REGION=nl

# ─── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
# Секрет для подписи запросов между bot и backend
BOT_SECRET=replace-with-random-string

# ─── Backups (опционально, оставьте BACKUP_S3_BUCKET пустым чтобы выключить) ──
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db-backups/
BACKUP_RETENTION_DAYS=30
# Секрет, которым sidecar триггерит /api/backups/run
BACKUP_TRIGGER_SECRET=replace-with-random-string
# Если backup использует отдельный S3 — заполнить, иначе оставить пустым
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
