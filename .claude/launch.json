{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend dev (npm)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "port": 5173
    },
    {
      "name": "Full Stack (Docker Compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "port": 5173
    },
    {
      "name": "Backend only",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build", "db", "backend"],
      "port": 8000
    },
    {
      "name": "Frontend only",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build", "frontend"],
      "port": 5173
    }
  ]
}
